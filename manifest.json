{
  "manifest_version": 3,
  "name": "SummarizeIt Gemini",
  "version": "1.2",
  "permissions": ["contextMenus", "storage", "notifications", "tabs"],
  "action": {
    "default_popup": "options.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon.png"
  },
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}